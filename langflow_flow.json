          "type": "CustomComponent",
          "node": {
            "display_name": "IBM watsonx.ai Granite",
            "description": "Memanggil IBM watsonx.ai dengan model Granite 3 8B Instruct",
            "base_classes": ["Message", "Text"],
            "template": {
              "_type": "Component",
              "code": {
                "type": "code",
                "required": true,
                "placeholder": "",
                "list": false,
                "show": false,
                "value": "from langflow.custom import Component\nfrom langflow.schema.message import Message\nfrom langflow.io import MessageInput, SecretStrInput, StrInput, IntInput, Output\n\nclass WatsonxGraniteComponent(Component):\n    display_name = 'IBM watsonx.ai Granite'\n    description = 'Generate teks menggunakan IBM Granite 3 8B via watsonx.ai'\n    icon = 'custom_components'\n\n    inputs = [\n        MessageInput(name='input_value', display_name='Input'),\n        SecretStrInput(name='api_key', display_name='IBM API Key', required=True),\n        StrInput(name='project_id', display_name='Project ID', required=True),\n        StrInput(name='model_id', display_name='Model ID', value='ibm/granite-3-8b-instruct'),\n        IntInput(name='max_new_tokens', display_name='Max Tokens', value=800),\n    ]\n\n    outputs = [\n        Output(display_name='Jawaban', name='output', method='generate'),\n    ]\n\n    def generate(self) -> Message:\n        from ibm_watsonx_ai.foundation_models import ModelInference\n        from ibm_watsonx_ai.credentials import Credentials\n\n        prompt = self.input_value.text if hasattr(self.input_value, 'text') else str(self.input_value)\n\n        model = ModelInference(\n            model_id=self.model_id,\n            credentials=Credentials(\n                url='https://us-south.ml.cloud.ibm.com',\n                api_key=self.api_key\n            ),\n            project_id=self.project_id,\n            params={\n                'max_new_tokens': self.max_new_tokens,\n                'temperature': 0.2,\n                'repetition_penalty': 1.1\n            }\n        )\n        answer = model.generate_text(prompt=prompt)\n        return Message(text=answer)\n",
